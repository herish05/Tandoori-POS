# Environment configuration. Only MAIN_VITE_* variables are exposed to the Electron main process.
# Nothing here is ever exposed to the renderer. Never place secrets (DB credentials, JWT secrets) in this file.
MAIN_VITE_APP_ENV=development
MAIN_VITE_LOG_LEVEL=debug
# Cloud API base URL (used from Phase 19). Leave empty to run purely local.
MAIN_VITE_CLOUD_API_URL=
